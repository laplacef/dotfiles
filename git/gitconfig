# Installed to ~/.gitconfig by install.sh.
# Identity lives in ~/.gitconfig-personal; see gitconfig-personal.example.

[user]
	useConfigOnly = true

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[includeIf "gitdir:~/repos/"]
	path = ~/.gitconfig-personal
